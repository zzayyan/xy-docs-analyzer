# Provider: "ollama" (default) or "openrouter"
PROVIDER=ollama

# Ollama runs on a GPU machine; point this at it
OLLAMA_BASE_URL=http://192.168.1.10:11434
LLM_MODEL=qwen3:14b
LLM_NUM_CTX=16384
EMBED_MODEL=bge-m3
EMBED_DIM=1024
TOKENIZER_MODEL=BAAI/bge-m3

# OpenRouter (required when PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LLM_MODEL=openrouter/free
OPENROUTER_EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_EMBED_DIM=2048

CHUNK_MAX_TOKENS=512
LONG_DOC_TOKENS=20000
CONTEXT_TOKEN_BUDGET=8000

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
