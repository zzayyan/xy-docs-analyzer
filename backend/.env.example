# LLM: "openai" for any OpenAI-compatible server (vLLM, OpenRouter, OpenAI), "ollama" for a local Ollama
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_MODEL=qwen3:14b
LLM_NUM_CTX=16384
# Extra model names selectable per document at upload time, alongside LLM_MODEL (the default).
# Every one must be reachable through LLM_PROVIDER/LLM_BASE_URL/LLM_API_KEY above.
LLM_MODEL_CHOICES=

# Embeddings: same two providers, configured separately because they often run elsewhere
EMBED_PROVIDER=openai
EMBED_BASE_URL=https://bge-m3-dev.wiratek.ai/v1
EMBED_API_KEY=
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
TOKENIZER_MODEL=BAAI/bge-m3

# Ingest costs roughly 10-19 s per PDF page, so these caps bound how long a user waits
MAX_UPLOAD_MB=100
MAX_PAGES=200

# Each Document's Original is kept under this directory until the Document is deleted (default: backend/data)
# DATA_DIR=/var/lib/docs-analyzer

# Section summaries and KG extraction run this many LLM calls at once
LLM_CONCURRENCY=8

CHUNK_MAX_TOKENS=512
LONG_DOC_TOKENS=20000
CONTEXT_TOKEN_BUDGET=8000

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
