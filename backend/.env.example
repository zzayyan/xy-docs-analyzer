# Admins can override the chat and Table Extraction models in Settings > Models; these stay the defaults.
# LLM: "openai" for any OpenAI-compatible server (vLLM, OpenRouter, OpenAI), "ollama" for a local Ollama
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_MODEL=qwen3:14b
LLM_NUM_CTX=16384
# OpenAI-compatible servers only, sent only when set. Qwen3.5 on vLLM needs "none", or answers come back
# as pure reasoning with empty content; leave unset for OpenAI's own models, which reject it.
# LLM_REASONING_EFFORT=none
# Extra model names selectable per document from the chat's model picker, alongside LLM_MODEL (the default).
# Every one must be reachable through LLM_PROVIDER/LLM_BASE_URL/LLM_API_KEY above.
LLM_MODEL_CHOICES=

# Table Extraction's own model (optional): any OpenAI-compatible endpoint. Set all three to route column
# proposals, suggestions and every per-chunk read there; leave TABLE_LLM_MODEL empty to use the document's model.
# TABLE_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# TABLE_LLM_API_KEY=
# TABLE_LLM_MODEL=deepseek-ai/deepseek-v4.1-flash

# Embeddings: same two providers, configured separately because they often run elsewhere
EMBED_PROVIDER=openai
EMBED_BASE_URL=https://bge-m3-dev.wiratek.ai/v1
EMBED_API_KEY=
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
TOKENIZER_MODEL=BAAI/bge-m3

# The first admin, created at startup only while no user exists; later accounts are made in the app
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Set to true when the API is served over HTTPS
# COOKIE_SECURE=true

# Ingest costs roughly 10-19 s per PDF page, so these caps bound how long a user waits
MAX_UPLOAD_MB=100
MAX_PAGES=200

# Each Document's Original is kept under this directory until the Document is deleted (default: backend/data)
# DATA_DIR=/var/lib/docs-analyzer

# Section summaries and KG extraction run this many LLM calls at once
LLM_CONCURRENCY=8

CHUNK_MAX_TOKENS=512
LONG_DOC_TOKENS=20000
CONTEXT_TOKEN_BUDGET=8000

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
